# --- AI agent (required for chat / API agent) ---
# LLM gateway key (Anthropic-compatible /v1/messages). Needs the gateway enabled on the key and credits.
LLM_API_KEY=
LLM_BASE_URL=https://llm.bankr.bot
AGENT_MODEL=claude-opus-5.5
AGENT_MAX_TOKENS=4096
# Model marketplace upstream: adds 300+ models from 50+ providers to the Kekr LLM Gateway.
OPENROUTER_API_KEY=
# Kekr LLM Gateway (resells the upstream gateways to your users, billed from prepaid credits)
LLM_MARKUP=1.2                       # price multiplier over the upstream price (1.2 = 20% margin)
LLM_REQUESTS_PER_MINUTE=60
NEXT_PUBLIC_TREASURY_ADDRESS=        # receives ETH for credit top ups
NEXT_PUBLIC_LLM_MIN_TOPUP_USD=1
# Alternative: call Anthropic directly instead of the gateway (leave LLM_API_KEY empty).
# ANTHROPIC_API_KEY=

# --- Durable storage (required on Vercel) ---
# Add "Upstash for Redis" from the Vercel Marketplace; it sets these automatically.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Chain ---
# Public RPC is used by default. Use a private RPC in production for higher rate limits.
NEXT_PUBLIC_RPC_URL=https://rpc.mainnet.chain.robinhood.com
RPC_URL=
INDEXER_LOOKBACK_BLOCKS=12000000     # ~14 days; or set INDEXER_START_BLOCK for a fixed start
INDEXER_LOG_CHUNK=2000000

# --- Sign in (Privy: email, SMS, X, Farcaster, Telegram + embedded wallets) ---
# Create an app at dashboard.privy.io, enable those login methods and add Robinhood Chain (4663).
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=                    # server side: links Privy users to their wallets (Club checks)

# --- Wallets ---
# Platform wallet that pays for gas-free (sponsored) launches. Keep it funded with a little ETH.
DEPLOYER_PRIVATE_KEY=
SPONSORED_LAUNCHES_PER_DAY=3

# --- Club (token gated) ---
# Club = wallets holding at least NEXT_PUBLIC_CLUB_MIN_HOLD of the official token.
# Only Club members can launch tokens (web, agent, API, X).
NEXT_PUBLIC_OFFICIAL_TOKEN_ADDRESS=  # set once the official token is live
NEXT_PUBLIC_OFFICIAL_TOKEN_SYMBOL=KEKR
NEXT_PUBLIC_CLUB_MIN_HOLD=1000000
# Comma separated team wallets that always count as Club (e.g. to launch the official token itself).
CLUB_ALLOWLIST=
FREE_MESSAGES_PER_DAY=5

# --- IPFS (logo uploads) ---
PINATA_JWT=
NEXT_PUBLIC_IPFS_GATEWAY=https://ipfs.io/ipfs/

# --- Socials ---
NEXT_PUBLIC_X_HANDLE=kekrbot
INTERNAL_SECRET=                     # shared secret for scripts/x-bot.mjs
X_BEARER_TOKEN=
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
X_BOT_USER_ID=

# --- Storage ---
DATA_DIR=.data
FALLBACK_ETH_USD=3500
